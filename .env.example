# Copy to .env and fill in:  cp .env.example .env
#
# .env is gitignored and is the single place local configuration lives. Real environment
# variables always take priority over this file, which is how CI supplies the same settings
# from repository secrets without a .env being present.

# --- Which repository the app checks for updates -------------------------------------
# The repository is public, so the app reads its releases anonymously — no credential of
# any kind is needed here or on the device.
APP_GITHUB_OWNER=augustinavicius
APP_GITHUB_REPO=nutrition

# --- Release signing ------------------------------------------------------------------
# Written for you by ./scripts/setup-release-signing.sh. Without these, assembleRelease
# falls back to the debug key and produces an APK that cannot update a real install.
APP_KEYSTORE_FILE=release.jks
APP_KEYSTORE_PASSWORD=
APP_KEY_ALIAS=nutrition
APP_KEY_PASSWORD=

# --- Version --------------------------------------------------------------------------
# CI sets these from the workflow run number; leave them unset locally.
# APP_VERSION_CODE=1
# APP_VERSION_NAME=1.0.1

# --- Android SDK ----------------------------------------------------------------------
# Only needed if ANDROID_HOME is not already exported in your shell. Used once, to
# generate local.properties on a fresh clone.
# ANDROID_HOME=/path/to/Android/Sdk
